# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SPRING_MAIL_FROM=your_email@gmail.com

# Local Database Configuration
LOCAL_DB_URL=jdbc:postgresql://localhost:5432/water_monitoring_db
LOCAL_DB_USERNAME=postgres
LOCAL_DB_PASSWORD=postgres

# Production Database Configuration
DB_URL=jdbc:postgresql://your-neon-host.neon.tech/neondb?sslmode=require
DB_USERNAME=your_db_owner
DB_PASSWORD=your_db_password

# JWT Settings
JWT_SECRET=your_base64_or_64_character_jwt_secret_key_here

# Razorpay Integration (Optional)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Frontend Configuration
FRONTEND_URL=http://localhost:5173
