# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SPRING_MAIL_FROM=noreply@hydrosync.com

# Local Database Configuration
LOCAL_DB_URL=jdbc:postgresql://localhost:5432/water_monitoring_db
LOCAL_DB_USERNAME=postgres
LOCAL_DB_PASSWORD=postgres

# Production Database Configuration
DB_URL=jdbc:postgresql://your-neon-host.neon.tech/neondb?sslmode=require
DB_USERNAME=your_db_owner
DB_PASSWORD=your_db_password

# JWT Settings
JWT_SECRET=your_jwt_secret_key_min_32_chars

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Razorpay Credentials
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

